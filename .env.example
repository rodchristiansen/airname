# AirName Build Configuration
# Copy this file to .env and fill in your organization's details

# Code Signing Identity (Developer ID Application certificate)
DEVELOPER_ID_APP="Developer ID Application: Your Organization Name (TEAMID)"

# Apple Developer Team ID
DEVELOPMENT_TEAM="TEAMID"

# Bundle Identifier (use your organization's domain)
BUNDLE_ID="com.yourorg.yourteam.AirName"

# Notarization Method 1: Direct credentials (choose this OR method 2)
APPLE_ID="your@apple.id"
NOTARIZATION_PASSWORD="your-app-specific-password"

# Notarization Method 2: Stored credentials profile (choose this OR method 1)
# First run: xcrun notarytool store-credentials "notarization_credentials" --apple-id "your@apple.id" --team-id "TEAMID"
# Then set: NOTARIZATION_PROFILE="notarization_credentials"
NOTARIZATION_PROFILE=""